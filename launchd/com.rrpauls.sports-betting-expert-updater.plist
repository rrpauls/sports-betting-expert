<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rrpauls.sports-betting-expert-updater</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/pyenv</string>
		<string>exec</string>
		<string>python</string>
		<string>/Users/owner/Projects/sports-betting-expert/scripts/update_plugin.py</string>
		<string>--codex</string>
		<string>/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/owner</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>86400</integer>
	<key>StandardOutPath</key>
	<string>/Users/owner/Library/Logs/sports-betting-expert-updater.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/owner/Library/Logs/sports-betting-expert-updater.err</string>
</dict>
</plist>
